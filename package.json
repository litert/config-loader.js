{
  "name": "@litert/config-loader",
  "version": "2.0.0",
  "description": "A configuration file loader for JavaScript application.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "typings": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./encodings": {
      "types": "./lib/Encodings/index.d.ts",
      "default": "./lib/Encodings/index.js"
    },
    "./encodings/*": {
      "types": "./lib/Encodings/*.d.ts",
      "default": "./lib/Encodings/*.js"
    },
    "./operators": {
      "types": "./lib/Operators/index.d.ts",
      "default": "./lib/Operators/index.js"
    },
    "./operators/*": {
      "types": "./lib/Operators/*.d.ts",
      "default": "./lib/Operators/*.js"
    },
    "./readers/*": {
      "types": "./lib/Readers/*.d.ts",
      "default": "./lib/Readers/*.js"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run rebuild",
    "build": "tsc -v && tsc -p .",
    "build-html-doc": "./utils/generate-api-docs-html.sh",
    "build-watch": "tsc -v && tsc -w -p .",
    "rebuild": "npm run clean && npm run lint && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib examples test",
    "lint": "./utils/eslint.sh",
    "prepare": "husky",
    "test": "node --enable-source-maps --test --experimental-test-coverage lib/**/*.test.js lib/*.test.js"
  },
  "keywords": [
    "litert",
    "lrt",
    "config"
  ],
  "author": "Angus.Fenying <fenying@litert.org> (https://fenying.net)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litert/config-loader.js.git"
  },
  "bugs": {
    "url": "https://github.com/litert/config-loader.js/issues"
  },
  "homepage": "https://github.com/litert/config-loader.js#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@litert/eslint-plugin-rules": "^0.3.1",
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "undici": "^8.5.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@litert/utils-object": "^2.0.0",
    "@litert/utils-string": "^2.0.0",
    "@litert/utils-ts-types": "^2.0.0"
  }
}
